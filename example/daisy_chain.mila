object iter_pipeline {
	var _iter: "<iterable>" = none;
	fn new(self: "<self>", iter: "<iterable>") -> "<self>" {
		var new: "<self>" = copy(self);
		set new["_iter"] = iter;
		return new;
	}
    fn map(self: "<self>", fun: "<callable>") -> "<self>" {
        foreach index : range(list.len(self["_iter"])) {
            set self["_iter"][index] = fun(self["_iter"][index]);
        }
        return self;
    }
    fn ':display'(self):[print, repr] {
        print("iter_pipeline(" + repr(self["_iter"]) + ")");
    }
}

export([@
    "iter_pipeline"=iter_pipeline
]);
