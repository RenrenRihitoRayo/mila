object iter_pipeline {
	var _iter: "<iterable>" = none;
	fn new(self: "<self>", iter: "<iterable>") -> "<self>" {
		var new: "<self>" = copy(self);
		set new["_iter"] = iter;
		return new;
	}
	fn sort(self: "<self>") -> "<self>" { println("iter_pipeline:sort("+ repr(self["_iter"]) +")"); return self; }
	fn shuffle(self: "<self>") -> "<self>" { println("iter_pipeline:shuffle("+ repr(self["_iter"]) +")"); return self; }
	fn map(self: "<self>", fun: "<callable>") -> "<self>" { println("iter_pipeline:map("+ repr(self["_iter"]) +", "+ repr(fun) +")"); return self; }
}

iter_pipeline:new([1, 2, 3]):sort():shuffle():map(println);
