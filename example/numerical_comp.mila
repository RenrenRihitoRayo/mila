#!/env/bin mila

!fn (argc, name, argv)

println("[91] > [90]", [91] > [90]);
println("[90] > [91]", [90] > [91]);

println("[90] < [91]", [90] < [91]);
println("[91] < [90]", [91] < [90]);

println("[91] => [90]", [91] >= [90]);
println("[90] => [90]", [90] >= [90]);
println("[90] => [91]", [90] >= [91]);

println("[90] =< [91]", [90] <= [91]);
println("[90] =< [90]", [90] <= [90]);
println("[91] =< [90]", [91] <= [90]);

println("[90] == [90]", [90] == [90]);
println("[90] == [91]", [90] == [91]);

println("[90] != [91]", [90] != [91]);
println("[90] != [90]", [90] != [90]);

fn vertool(version_string: "string") -> "list[string]" {
    return map(str.split(version_string, "."), cast.int);
}

var version_string = "0.0.1";
println(vertool(version_string), version_string);
