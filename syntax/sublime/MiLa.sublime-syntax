%YAML 1.2
---
name: MiLa
file_extensions: [mila]
scope: source.mila

contexts:
  main:
    - include: comment-block
    - include: comment-line
    - include: string
    - include: statements
    - include: builtins
    - include: constant
    - include: number
    - include: operator

  comment-line:
    - match: '#!.*$'
      scope: comment.line.mila
    - match: '//.*$'
      scope: comment.line.mila

  comment-block:
    - match: '/\*'
      scope: comment.block.mila
      push:
        - meta_scope: comment.block.mila
        - match: '\*/'
          pop: true

  string:
    - match: '"'
      scope: string.quoted.double.mila
      push:
        - meta_scope: string.quoted.double.mila
        - match: '\\[ntr\\"''abfvx]|\\x[0-9a-fA-F]{2}'
          scope: constant.character.escape.mila
        - match: '"'
          pop: true

  statements:
    - match: '\b(alias|catch|if|elif|const|else|object|while|fn|set|var|sync|forget|return|break|continue|foreach)\b'
      scope: keyword.control.mila
    - match: '@[\w_.]+'
      scope: keyword.control.mila
  
  builtins:
    - match: '\b(dump_mila_search_paths|thread\.get_pthread_id|str\.caseless_contains|thread\.check_cancel|_debug\.get_weakrefs|thread\.mutex_unlock|str\.caseless_find|str\.match_replace|ascii\.from_string|thread\.set_daemon)\b'
      scope: support.function.mila
    - match: '\b(thread\.mutex_lock|sys\.get_platform|list\.deconstruct|fread_all_bytes|str\.match_find|hash\._get_seed|str\.startswith|ascii\.from_int|mjson\.dumps_io|_debug\.get_mem)\b'
      scope: support.function.mila
    - match: '\b(list\.contains|thread\.status|thread\.cancel|hash\.set_seed|time_sleep_ms|report_tagged|json\.dumps_io|file\.list_dir|get_tm_local|sys\.get_arch)\b'
      scope: support.function.mila
    - match: '\b(fprint_bytes|str\.contains|str\.endswith|thread\.mutex|file\.is_file|mjson\.dumps|thread\.join|mjson\.loads|str\.tolower|from_opaque)\b'
      scope: support.function.mila
    - match: '\b(file\.exists|str\.toupper|file\.is_dir|_breakpoint|list\.append|sys\.get_pid|thread\.dump|thread\.make|fread_bytes|sys\.getenv)\b'
      scope: support.function.mila
    - match: '\b(fdredirect|list\.index|list\.slice|array\.from|cast\.float|is_numeric|json\.loads|json\.dumps|time_sleep|get_tm_gmt)\b'
      scope: support.function.mila
    - match: '\b(sys\.setenv|str\.split|str\.patch|str\.index|str\.pop_b|dict\.keys|str\.slice|fread_all|str\.pop_f|as_opaque)\b'
      scope: support.function.mila
    - match: '\b(array\.len|repr_raw|strftime|get_time|list\.len|list\.pop|cast\.int|str\.copy|str\.join|cast\.i2f)\b'
      scope: support.function.mila
    - match: '\b(cast\.i2u|cast\.u2i|str\.find|cast\.f2i|dict\.rem|cast\.str|srandom|crandom|_typeof|require)\b'
      scope: support.function.mila
    - match: '\b(istring|println|str\.len|assert|fdopen|printr|report|fflush|isatty|random)\b'
      scope: support.function.mila
    - match: '\b(readch|system|invoke|typeof|fprint|fclose|print|ftell|fseek|fread)\b'
      scope: support.function.mila
    - match: '\b(close|floor|sqrtf|atan2|abort|unown|input|range|vkill|qsort)\b'
      scope: support.function.mila
    - match: '\b(noise|array|fabs|rand|dict|open|sqrt|load|eval|copy)\b'
      scope: support.function.mila
    - match: '\b(hash|ceil|repr|exit|list|xor|pow|tan|cos|own)\b'
      scope: support.function.mila
    - match: '\b(not|and|run|sin|abs|is|or)\b'
      scope: support.function.mila

  constant:
    - match: '\b(true|false|null|none|stderr|stdout|SEEK_SET|SEEK_END|SEEK_CUR)\b'
      scope: constant.language.mila

  number:
    - match: '\b\d+\.?\d*u?\b'
      scope: constant.numeric.mila

  operator:
    - match: '\+\=|\-\=|\*\=|\/\=|\%\=|\=\=|\!\=|\?\?|\<\=|\>\=|\&\&|\|\||[+\-*/=<>!:%?&|\?]'
      scope: keyword.operator.mila
